# Copy to .env.local.

# Where the API lives, as seen FROM THE NEXT.JS SERVER. Only used by the
# /api rewrite in next.config.ts — it is never sent to the browser.
#   dev:  http://localhost:4000
#   prod: https://<your-service>.onrender.com   (set this in Vercel's dashboard)
BACKEND_ORIGIN=http://localhost:4000

# Where the API lives, as seen FROM THE BROWSER. Leave it at the default: `/api`
# is same-origin, so the session cookie is first-party and no browser's
# third-party-cookie policy can drop it. Only override this to call a backend
# directly (which then needs COOKIE_SAMESITE=none on that backend).
NEXT_PUBLIC_API_URL=/api
